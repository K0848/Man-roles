{
  "name": "man-roles-roleplayer",
  "version": "0.1.0",
  "description": "Man-roles 单人物最小垂直切片插件：用户原话保存、困惑 candidate→confirmed/corrected 状态机、Projection 困惑状态展示、下一轮上下文装配",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./src/client/remote-probe.ts",
      "default": "./lib/client-remote-probe.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:mvp-v2": "node --test tests/mvp-v2-contract.test.mjs tests/mvp-v2-scope.test.mjs tests/product-remote-compat.test.mjs tests/web-profile-composition.test.mjs tests/mvp-v2-task3-6.test.mjs tests/mvp-client-report.test.mjs tests/mvp-report.test.mjs",
    "test:legacy-contract": "node --test tests/phase7-integration-gap.test.mjs tests/phase7-task9-v2-contract.test.mjs tests/dialogue-policy.test.mjs tests/dialogue-control.test.mjs",
    "validate:mvp-v2": "powershell -ExecutionPolicy Bypass -File scripts/run-mvp-v2-validation.ps1",
    "validate:mvp-v2:final": "powershell -ExecutionPolicy Bypass -File scripts/run-mvp-v2-validation.ps1 -Final",
    "validate:mvp-web-compat": "powershell -ExecutionPolicy Bypass -File scripts/run-mvp-web-compat.ps1",
    "validate:loop:unit": "node --test tests/control-loop-validation.test.mjs tests/aggregate.test.mjs tests/branch-manager.test.mjs tests/assemble-dual.test.mjs tests/trunk-storage.test.mjs",
    "validate:loop": "powershell -ExecutionPolicy Bypass -File scripts/run-control-loop-validation.ps1"
    ,"validate:task9:scripted": "powershell -ExecutionPolicy Bypass -File scripts/run-phase7-task9-scripted.ps1"
    ,"validate:task9:real:preflight": "powershell -ExecutionPolicy Bypass -File scripts/run-phase7-task9-real.ps1 -PreflightOnly"
    ,"validate:task9:real:preflight:attempt2": "powershell -ExecutionPolicy Bypass -File scripts/run-phase7-task9-real.ps1 -PreflightOnly -Attempt attempt-2.json"
    ,"validate:task9:real:preflight:attempt3": "powershell -ExecutionPolicy Bypass -File scripts/run-phase7-task9-real.ps1 -PreflightOnly -Attempt attempt-3.json"
    ,"validate:task9:real:preflight:attempt4": "powershell -ExecutionPolicy Bypass -File scripts/run-phase7-task9-real.ps1 -PreflightOnly -Attempt attempt-4.json"
  }
}
